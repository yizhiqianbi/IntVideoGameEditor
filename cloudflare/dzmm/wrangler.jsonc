{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dzmm-backend",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-02",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "vars": {
    "APP_ORIGINS": "http://127.0.0.1:3010,http://localhost:3010",
    "STRIPE_PAYMENT_MODE": "test",
    "PAYMENTS_ACCEPTING_ENABLED": "false",
    "NOWPAYMENTS_ENABLED": "false",
    "NOWPAYMENTS_PAY_CURRENCY": "usdttrc20",
    "SUBSCRIPTION_ENABLED": "false",
    "SUBSCRIPTION_PLANS_JSON": "[{\"id\":\"vip_monthly\",\"label\":\"叙梦 VIP\",\"revision\":3,\"amountMinor\":2800,\"currency\":\"cny\",\"durationDays\":30,\"dailyCredits\":300,\"maxClaims\":30,\"timezone\":\"Asia/Shanghai\"}]",
    "PAYMENTS_RETURN_ORIGIN": "https://xumengchat.top",
    "EMAIL_AUTH_ENABLED": "false",
    "EMAIL_PROVIDER": "cloudflare",
    "EMAIL_FROM": "noreply@auth.xumengchat.top"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dzmm-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "dzmm-media"
    }
  ],
  "images": {
    "binding": "IMAGES"
  }
}
