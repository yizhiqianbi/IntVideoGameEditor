{
  "name": "dzmm-cloudflare-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local --ip 127.0.0.1 --port 8787",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote --config wrangler.production.jsonc",
    "check": "tsc --noEmit",
    "deploy:dry-run": "wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "deploy:production:dry-run": "wrangler deploy --dry-run --config wrangler.production.jsonc --outdir .wrangler/production-dry-run",
    "deploy:production": "wrangler deploy --config wrangler.production.jsonc",
    "stripe:configure:test": "node scripts/configure-stripe-test.mjs",
    "stripe:configure:live": "node scripts/configure-stripe-live.mjs",
    "test": "node scripts/test.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261002.1",
    "@types/node": "^25.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "wrangler": "^4.146.0"
  },
  "dependencies": {
    "@elevenlabs/elevenlabs-js": "^2.76.0"
  }
}
