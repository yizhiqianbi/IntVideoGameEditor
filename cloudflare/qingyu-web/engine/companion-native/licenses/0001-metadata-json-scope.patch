+from pathlib import Path
+from types import SimpleNamespace
+
+import pytest
+
+from src.A_memorix.core.runtime.services.search_hit_processing_service import MemorySearchHitProcessingService
+from src.A_memorix.core.storage import MetadataStore
+
+
+def test_person_fact_scope_reads_real_sqlite_json_and_excludes_other_chats(tmp_path: Path) -> None:
+    store = MetadataStore(data_dir=tmp_path / "metadata")
+    store.connect()
+    try:
+        current = store.add_paragraph(
+            "合成用户甲喜欢桂花乌龙，不加糖",
+            source="person_fact:person-current",
+            metadata={"chat_id": "session-current", "chat_ids": ["session-current"]},
+        )
+        other = store.add_paragraph(
+            "合成用户乙喜欢薄荷茶",
+            source="person_fact:person-other",
+            metadata={"chat_id": "session-other", "chat_ids": ["session-other"]},
+        )
+        explicit_global = store.add_paragraph(
+            "公开的合成背景资料",
+            source="manual",
+            metadata={"scope_type": "global"},
+        )
+        raw_rows = store.query("SELECT hash, metadata FROM paragraphs")
+        assert all(isinstance(row["metadata"], str) for row in raw_rows)
+        service = MemorySearchHitProcessingService(SimpleNamespace(metadata_store=store))
+
+        scope = service._resolve_retrieval_scope("session-current")
+        assert scope is not None
+        assert scope.paragraph_ids == frozenset({current, explicit_global})
+        assert other not in scope.paragraph_ids
+
+        other_scope = service._resolve_retrieval_scope("session-other")
+        assert other_scope is not None
+        assert other_scope.paragraph_ids == frozenset({other, explicit_global})
+        assert current not in other_scope.paragraph_ids
+    finally:
+        store.close()
+
+
+@pytest.mark.parametrize("metadata", ["{invalid", "null", '"session-current"', "7", "true", '[]', '[{"chat_id":"session-current"}]'])
+def test_malformed_or_non_object_metadata_does_not_grant_scope(metadata: str) -> None:
+    assert MemorySearchHitProcessingService._paragraph_scope_identity(
+        {"source": "person_fact:test", "metadata": metadata}
+    ) == ("unknown", set())
+
+
+def test_already_decoded_metadata_keeps_existing_scope() -> None:
+    assert MemorySearchHitProcessingService._paragraph_scope_identity(
+        {"source": "person_fact:test", "metadata": {"scope_type": "chat", "chat_ids": ["session-current"]}}
+    ) == ("chat", {"session-current"})
