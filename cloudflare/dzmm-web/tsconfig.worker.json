{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["@cloudflare/workers-types", "node"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "src/entry.ts",
    "test/**/*.mts",
    "../../src/lib/dzmm-chat-handler.ts",
    "../../src/lib/dzmm-chat.ts"
  ],
  "exclude": ["node_modules", ".wrangler", "dist"]
}
