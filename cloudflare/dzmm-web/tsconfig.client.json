{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "types": ["vite/client", "node"],
    "paths": { "@/*": ["../../src/*"] }
  },
  "include": [
    "src/main.tsx",
    "src/ops-main.tsx",
    "src/env.d.ts",
    "vite.config.ts",
    "../../src/components/dzmm/**/*.tsx",
    "../../src/lib/dzmm-characters.ts",
    "../../src/lib/dzmm-context.ts",
    "../../src/lib/dzmm-cloud.ts",
    "../../src/lib/dzmm-storage.ts"
  ],
  "exclude": ["node_modules", "dist", ".wrangler", "**/*.test.mts"]
}
