  "chat": {
    "transport": "authenticated POST /api/chat; client response.json()",
    "requestFields": [
      "kind",
      "characterId",
      "clientTurnId",
      "rungIndex",
      "history",
      "conversationSummary?",
      "userMessage",
      "dynamic",
      "locale?",
      "imageDataURL?",
      "pronunciation?"
