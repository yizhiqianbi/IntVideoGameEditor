    "dynamicFields": [
      "firstConversation",
      "userName",
      "birthdayISO",
      "ageBand",
      "affectionLevel",
      "userFacts",
      "harness",
      "lastAssistantAt",
      "nowMs",
      "tzOffsetMinutes",
      "personaReminder",
      "proactive?"
    ],
    "responseContentPath": "choices[0].message.content",
    "optionalMetadata": [
      "model",
      "provider",
      "usage",
      "budget",
      "pilot",
      "voiceGrant"
    ],
    "mainSystemAndModelSentByClient": false,
    "logicalRequestFrozenForRetry": true
  },
  "presentation": {
    "storedAssistantMessagesPerReply": 1,
    "uiPieceFields": [
      "sourceMessage",
      "pieceIndex"
    ],
    "parserForms": [
      "reply/text/emotion/photo_description XML-like",
      "plain text",
      "trailing emotion marker"
    ],
    "parserBubblesIsPrimaryDisplay": false,
    "primaryGrouping": {
      "first": "accumulate sentences until 4 word units or no sentences remain",
      "rest": "pairs of sentences",
      "hardThreeBubbleLimit": false,
      "cjkUnits": "count Han/Hiragana/Katakana per whitespace token, min 1",
      "scope": "PE presentation pieces; not final DOM rows"
    },
    "textOnlyCps": {
      "Nari": 19.1,
      "Yume": 21
    },
    "ttsEvents": "piece start/end drive reveal",
    "domRender": {
      "chain": "ChatLayer / Im / tI / eI / JS",
      "firstPiece": "one meaningful sentence per row",
      "laterPieces": "usually pairs; 1 in each 5 pieces chosen via stable original reply ID FNV-style hash uses singles",
      "newlineSplit": true,
      "sentenceSuffix": "UTF-16 start offset within current text",
      "historyReconstructsSourceGrouping": true,
      "dateCompatibility": true,
      "staticSupplementNotIncludedInOriginal7Fixtures": true
    }
  },
  "memory": {
    "kind": "memory",
    "v": 2,
    "sections": [
      "slots",
      "facts",
      "plans",
      "story",
      "self"
    ],
    "batch": {
      "minPairs": 8,
      "maxPairs": 16,
      "minUserChars": 24,
      "timeoutMs": 45000
    },
    "caps": {
      "facts": 60,
      "plans": 12,
      "storyPerCharacter": 14,
      "selfPerCharacter": 14
    },
    "retrieval": {
      "maxFacts": 9,
      "approxWhitespaceWords": 120,
      "englishKeywordPattern": "[a-z]{4,}",
      "pureChineseMatchLimitation": true
    },
    "providerPromptVisible": false
  },
  "proactive": {
    "tickMs": 60000,
    "foreground": true,
    "requires": [
      "main chat home",
      "empty composer",
      "no overlay",
      "no generation/input/reveal busy",
      "quota access"
    ],
    "quiet": "22:00–07:00; weekends until 09:00",
    "request": "empty userMessage + dynamic.proactive",
    "notEveryTickSends": true
  },
  "oneShot": {
    "clientTaskPromptVisible": true,
    "fields": [
      "kind",
      "characterId?",
      "system",
      "user",
      "maxTokens",
      "temperature",
      "json",
      "purpose",
      "activityId?",
